# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/staxmed_db

# JWT Secret (WICHTIG: Ändere dies zu einem sicheren, zufälligen String!)
# Generiere einen sicheren Secret mit: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# StaxBox Configuration
STAX_MODE=SAAS
# STAX_MODE=STAXBOX  # Für On-Premise Installation

# Cloud Master URL (nur für STAXBOX Modus)
# CLOUD_MASTER_URL=https://api.staxmed.com

# StaxBox ID (nur für STAXBOX Modus)
# STAXBOX_ID=your-box-unique-id
