<div class="space-y-8">
  <section>
    <h3 class="text-lg font-semibold text-main mb-4">Erscheinungsbild</h3>
    <div class="flex gap-4">
      <button 
        (click)="themeService.theme.set('light')"
        [class.ring-2]="themeService.theme() === 'light'"
        class="flex-1 p-4 rounded-lg border-border bg-white text-slate-900 ring-primary"
      >
        ☀️ Hell
      </button>
      <button 
        (click)="themeService.theme.set('dark')"
        [class.ring-2]="themeService.theme() === 'dark'"
        class="flex-1 p-4 rounded-lg border-border bg-slate-900 text-white ring-primary"
      >
        🌙 Dunkel
      </button>
    </div>
  </section>

  <section>
    <h3 class="text-lg font-semibold text-main mb-4">Farbschema</h3>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div 
        (click)="themeService.setSchema('clinical')"
        class="cursor-pointer p-4 rounded-xl border-2 transition-all hover:shadow-md"
        [class.border-primary]="themeService.schema() === 'clinical'"
      >
        <div class="h-4 w-full bg-[#2563eb] rounded mb-2"></div> <span class="font-medium text-main">Clinical Pro</span>
        <p class="text-xs text-muted mt-1">Seriös & Medizintechnisch</p>
      </div>

      <div 
        (click)="themeService.setSchema('operator')"
        class="cursor-pointer p-4 rounded-xl border-2 transition-all hover:shadow-md"
        [class.border-primary]="themeService.schema() === 'operator'"
      >
        <div class="h-4 w-full bg-[#4f46e5] rounded mb-2"></div>
        <span class="font-medium text-main">Modern Operator</span>
        <p class="text-xs text-muted mt-1">Modern & Kontrastreich</p>
      </div>

      <div 
        (click)="themeService.setSchema('tactical')"
        class="cursor-pointer p-4 rounded-xl border-2 transition-all hover:shadow-md"
        [class.border-primary]="themeService.schema() === 'tactical'"
      >
        <div class="h-4 w-full bg-[#059669] rounded mb-2"></div>
        <span class="font-medium text-main">Emergency Tactical</span>
        <p class="text-xs text-muted mt-1">Hohe Signalwirkung</p>
      </div>
    </div>
  </section>
</div>
