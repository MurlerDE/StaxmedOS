/* You can add global styles to this file, and also import other style files */

@import "tailwindcss";

/* -------------------------------------------------------------------------- */
/* 1. SCHEMA: THE CLINICAL PRO (Blau/Teal - Seriös & Medizintechnisch)        */
/* -------------------------------------------------------------------------- */

[data-schema='clinical'] {
  --color-bg: #f8fafc;        /* Slate-50 */
  --color-surface: #ffffff;
  --color-primary: #2563eb;   /* Blue-600 */
  --color-primary-hover: #1d4ed8;
  --color-secondary: #14b8a6; /* Teal-500 */
  --color-text-main: #0f172a; /* Slate-900 */
  --color-text-muted: #64748b;/* Slate-500 */
  --color-border: #e2e8f0;    /* Slate-200 */
  --color-accent: #fbbf24;    /* Amber-400 */
}

[data-schema='clinical'][data-theme='dark'] {
  --color-bg: #020617;        /* Slate-950 */
  --color-surface: #0f172a;   /* Slate-900 */
  --color-primary: #3b82f6;   /* Blue-500 */
  --color-primary-hover: #60a5fa;
  --color-secondary: #2dd4bf; /* Teal-400 */
  --color-text-main: #f1f5f9; /* Slate-100 */
  --color-text-muted: #94a3b8;/* Slate-400 */
  --color-border: #1e293b;    /* Slate-800 */
  --color-accent: #f59e0b;    /* Amber-500 */
}

/* -------------------------------------------------------------------------- */
/* 2. SCHEMA: THE MODERN OPERATOR (Indigo/Amber - Modern & SaaS-Style)       */
/* -------------------------------------------------------------------------- */

[data-schema='operator'] {
  --color-bg: #fafafa;        /* Zinc-50 */
  --color-surface: #ffffff;
  --color-primary: #4f46e5;   /* Indigo-600 */
  --color-primary-hover: #4338ca;
  --color-secondary: #e2e8f0; /* Slate-200 */
  --color-text-main: #18181b; /* Zinc-900 */
  --color-text-muted: #71717a;/* Zinc-500 */
  --color-border: #e4e4e7;    /* Zinc-200 */
  --color-accent: #fbbf24;    /* Amber-400 */
}

[data-schema='operator'][data-theme='dark'] {
  --color-bg: #09090b;        /* Zinc-950 */
  --color-surface: #18181b;   /* Zinc-900 */
  --color-primary: #818cf8;   /* Indigo-400 */
  --color-primary-hover: #a5b4fc;
  --color-secondary: #3f3f46; /* Zinc-700 */
  --color-text-main: #f4f4f5; /* Zinc-100 */
  --color-text-muted: #a1a1aa;/* Zinc-400 */
  --color-border: #27272a;    /* Zinc-800 */
  --color-accent: #fbbf24;    /* Amber-400 */
}

/* -------------------------------------------------------------------------- */
/* 3. SCHEMA: EMERGENCY TACTICAL (Emerald/Black - Kontrastreich & Direkt)    */
/* -------------------------------------------------------------------------- */

[data-schema='tactical'] {
  --color-bg: #f5f5f5;        /* Neutral-100 */
  --color-surface: #ffffff;
  --color-primary: #059669;   /* Emerald-600 */
  --color-primary-hover: #047857;
  --color-secondary: #0ea5e9; /* Sky-500 */
  --color-text-main: #171717; /* Neutral-900 */
  --color-text-muted: #737373;/* Neutral-500 */
  --color-border: #d4d4d4;    /* Neutral-300 */
  --color-accent: #f43f5e;    /* Rose-500 */
}

[data-schema='tactical'][data-theme='dark'] {
  --color-bg: #000000;        /* Pure Black */
  --color-surface: #171717;   /* Neutral-900 */
  --color-primary: #10b981;   /* Emerald-500 */
  --color-primary-hover: #34d399;
  --color-secondary: #38bdf8; /* Sky-400 */
  --color-text-main: #e5e5e5; /* Neutral-200 */
  --color-text-muted: #a3a3a3;/* Neutral-400 */
  --color-border: #262626;    /* Neutral-800 */
  --color-accent: #f43f5e;    /* Rose-500 */
}

/* -------------------------------------------------------------------------- */
/* GLOBAL SEMANTIC COLORS (Bleiben immer gleich für intuitive Bedienung)      */
/* -------------------------------------------------------------------------- */

:root {
  --color-success: #22c55e;   /* Green-500 */
  --color-error: #ef4444;     /* Red-500 */
  --color-warning: #f59e0b;   /* Amber-500 */
}
